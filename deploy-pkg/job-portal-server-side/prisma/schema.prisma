generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model job_seekers {
  job_seeker_id     String              @id @default(uuid())
  email             String              @unique
  password          String
  full_name         String
  otp               String?
  otpExpires        DateTime?
  verified          verified            @default(false)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  lmsLinkedAt       DateTime?
  lmsUserId         String?
  applications      applications[]
  invitations       invitations[]
  job_seeker_detail job_seeker_details?
  request_apply     request_apply[]
  saved_jobs        saved_jobs[]
}

model job_seeker_details {
  job_seeker_detail_id String           @id @default(uuid())
  job_seeker_id        String           @unique
  profile_picture_url  String?
  personal_summary     String?          @db.Text
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  certifications       certifications[]
  education            education[]
  experiences          experiences[]
  job_seeker           job_seekers      @relation(fields: [job_seeker_id], references: [job_seeker_id], onDelete: Cascade)
  languages            languages[]
  personal_info        personal_info?
  projects             projects[]
  skills               skills[]
}

model personal_info {
  personal_info_id     String             @id @default(uuid())
  job_seeker_detail_id String             @unique
  address              String?
  phone_number         String?            @db.VarChar(15)
  date_of_birth        DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  job_seeker_details   job_seeker_details @relation(fields: [job_seeker_detail_id], references: [job_seeker_detail_id], onDelete: Cascade)
}

model education {
  education_id         String             @id @default(uuid())
  job_seeker_detail_id String
  university_id        String?
  university_name      String
  degree               String
  major                String
  start_date           DateTime
  end_date             DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  grade                String?
  job_seeker_details   job_seeker_details @relation(fields: [job_seeker_detail_id], references: [job_seeker_detail_id], onDelete: Cascade)
  university           universities?      @relation(fields: [university_id], references: [university_id])

  @@index([university_id], map: "education_university_id_fkey")
  @@map("education")
}

model experiences {
  experience_id        String             @id @default(uuid())
  job_seeker_detail_id String
  experience_title     String
  employment_type      String?
  company_name         String
  location             String?
  location_type        String?
  description          String?            @db.VarChar(255)
  start_date           DateTime?
  end_date             DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  job_seeker_details   job_seeker_details @relation(fields: [job_seeker_detail_id], references: [job_seeker_detail_id], onDelete: Cascade)

  @@index([job_seeker_detail_id], map: "experiences_job_seeker_detail_id_fkey")
}

model languages {
  language_id          String              @id @default(uuid())
  language_name        String
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  job_seeker_detail_id String?
  job_seeker_details   job_seeker_details? @relation(fields: [job_seeker_detail_id], references: [job_seeker_detail_id], onDelete: Cascade)

  @@unique([job_seeker_detail_id, language_name])
}

model skills {
  skill_id             String              @id @default(uuid())
  skill_name           String
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  job_seeker_detail_id String?
  job_seeker_details   job_seeker_details? @relation(fields: [job_seeker_detail_id], references: [job_seeker_detail_id], onDelete: Cascade)

  @@index([job_seeker_detail_id], map: "skills_job_seeker_detail_id_fkey")
}

model skills_category {
  skill_category_id String               @id @default(uuid())
  category_name     String               @unique
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  deleted_at        DateTime?
  jobs              jobs[]
  skills            skills_requirement[]
}

model projects {
  project_id           String             @id @default(uuid())
  job_seeker_detail_id String
  project_name         String
  description          String?            @db.VarChar(255)
  start_date           DateTime?
  end_date             DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  job_seeker_details   job_seeker_details @relation(fields: [job_seeker_detail_id], references: [job_seeker_detail_id], onDelete: Cascade)

  @@index([job_seeker_detail_id], map: "projects_job_seeker_detail_id_fkey")
}

model certifications {
  certification_id     String             @id @default(uuid())
  job_seeker_detail_id String
  certification_name   String
  issuing_organization String?
  issue_date           DateTime?
  expiration_date      DateTime?
  credential_url       String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  job_seeker_details   job_seeker_details @relation(fields: [job_seeker_detail_id], references: [job_seeker_detail_id], onDelete: Cascade)

  @@index([job_seeker_detail_id], map: "certifications_job_seeker_detail_id_fkey")
}

model approval {
  approval_id   String        @id @default(uuid())
  company_id    String?       @unique
  university_id String?       @unique
  notes         String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  company       companies?    @relation(fields: [company_id], references: [company_id])
  university    universities? @relation(fields: [university_id], references: [university_id])
}

model companies {
  company_id     String           @id @default(uuid())
  email          String           @unique
  password       String
  full_name      String
  phone_number   String           @db.VarChar(15)
  otp            String?
  otpExpires     DateTime?
  verified       verified         @default(false)
  status         status           @default(not_submitted)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  approval       approval?
  company_detail company_details?
  jobs           jobs[]
}

model company_details {
  company_detail_id String    @id @default(uuid())
  company_id        String    @unique
  logo_url          String?
  legal_name        String?
  market_name       String?
  category          String?
  company_size      String?
  description       String?   @db.Text
  country           String?
  province          String?
  city              String?
  district          String?
  full_address      String?
  postal_code       String?
  website           String?
  facebook_url      String?
  twitter_url       String?
  instagram_url     String?
  youtube_url       String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  company           companies @relation(fields: [company_id], references: [company_id])
}

model position_levels {
  position_level_id String   @id @default(uuid())
  position_name     String   @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model jobs {
  job_id                 String               @id @default(uuid())
  company_id             String
  title                  String
  category               job_category
  employment_type        String
  description            String               @db.Text
  location               String
  salary_type            salary_type
  minimum_salary         BigInt?
  maximum_salary         BigInt?
  education_requirement  String?
  experience_requirement String?
  status                 job_status           @default(draft)
  published_at           DateTime?
  expired_at             DateTime?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  work_type              work_type
  deleted_at             DateTime?
  skills_category_id     String
  applications           applications[]
  invitations            invitations[]
  benefits               job_benefits[]
  company                companies            @relation(fields: [company_id], references: [company_id])
  skills_category        skills_category      @relation(fields: [skills_category_id], references: [skill_category_id])
  request_apply          request_apply[]
  saved_jobs             saved_jobs[]
  skills_requirement     skills_requirement[]

  @@index([company_id], map: "jobs_company_id_fkey")
  @@index([skills_category_id], map: "jobs_skills_category_id_fkey")
}

model job_benefits {
  job_benefit_id String   @id @default(uuid())
  job_id         String
  benefit        String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  job            jobs     @relation(fields: [job_id], references: [job_id])

  @@index([job_id], map: "job_benefits_job_id_fkey")
}

model skills_requirement {
  skill_requirement_id String          @id @default(uuid())
  job_id               String
  skill                String
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  skill_category_id    String
  job                  jobs            @relation(fields: [job_id], references: [job_id])
  skill_category       skills_category @relation(fields: [skill_category_id], references: [skill_category_id])

  @@index([job_id], map: "skills_requirement_job_id_fkey")
  @@index([skill_category_id], map: "skills_requirement_skill_category_id_fkey")
}

model match_scores {
  match_score_id String       @id @default(uuid())
  application_id String       @unique
  overall        Float?
  summary        Float?
  skills         Float?
  experience     Float?
  education      Float?
  certifications Float?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  projects       Float?
  applications   applications @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
}

model applications {
  job_seeker_id    String
  job_id           String
  status           applicant_status @default(pending)
  resume_url       String
  expected_salary  BigInt?
  applied_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  application_id   String           @id @default(uuid())
  experience_years String?
  job              jobs             @relation(fields: [job_id], references: [job_id])
  job_seeker       job_seekers      @relation(fields: [job_seeker_id], references: [job_seeker_id], onDelete: Cascade)
  interviews       interviews?
  match_scores     match_scores?

  @@index([job_id], map: "applications_job_id_fkey")
  @@index([job_seeker_id], map: "applications_job_seeker_id_fkey")
}

model universities {
  university_id     String              @id @default(uuid())
  email             String              @unique
  password          String
  full_name         String
  otp               String?
  otpExpires        DateTime?
  verified          verified            @default(false)
  status            status              @default(not_submitted)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  approval          approval?
  students          education[]
  university_detail university_details?
}

model university_details {
  university_detail_id String       @id @default(uuid())
  university_id        String       @unique
  university_name      String       @unique
  logo_url             String?
  phone_number         String?      @db.VarChar(15)
  category             String?
  country              String?
  province             String?
  city                 String?
  district             String?
  full_address         String?
  postal_code          String?
  website              String?
  facebook_url         String?
  twitter_url          String?
  instagram_url        String?
  youtube_url          String?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  university           universities @relation(fields: [university_id], references: [university_id])
}

model admins {
  admin_id   String   @id @default(uuid())
  email      String   @unique
  full_name  String
  password   String
  role       role     @default(admin)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model saved_jobs {
  saved_job_id  String      @id @default(uuid())
  job_seeker_id String
  job_id        String
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  job           jobs        @relation(fields: [job_id], references: [job_id])
  job_seeker    job_seekers @relation(fields: [job_seeker_id], references: [job_seeker_id], onDelete: Cascade)

  @@unique([job_id, job_seeker_id])
  @@index([job_seeker_id], map: "saved_jobs_job_seeker_id_fkey")
}

model pages {
  slug       String        @unique
  title      String?       @db.VarChar(255)
  category   page_category
  content    String        @db.Text
  event_date DateTime?     @db.DateTime(0)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  page_id    String        @id @default(uuid())
  image_url  String?

  @@index([slug])
}

model log_activities {
  log_activity_id String   @id @default(uuid())
  user_id         String
  user_role       String
  activity        String
  created_at      DateTime @default(now())
}

model experience_levels {
  experience_level_id String   @id @default(uuid())
  name                String   @unique
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model settings {
  setting_id String   @id @default(uuid())
  key        String   @unique
  value      String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model interviews {
  interview_id   String       @id @default(uuid())
  application_id String       @unique
  interview_date DateTime
  meeting_link   String?
  notes          String?      @db.Text
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  application    applications @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
}

model invitations {
  invitation_id   String            @id @default(uuid())
  job_id          String
  job_seeker_id   String
  status          invitation_status @default(waiting_interview)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  interview_dates DateTime?
  job             jobs              @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  job_seeker      job_seekers       @relation(fields: [job_seeker_id], references: [job_seeker_id], onDelete: Cascade)

  @@unique([job_id, job_seeker_id])
  @@index([job_seeker_id], map: "invitations_job_seeker_id_fkey")
}

model request_apply {
  request_apply_id String               @id @default(uuid())
  job_id           String
  job_seeker_id    String
  status           request_apply_status @default(not_applied)
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  job              jobs                 @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  job_seeker       job_seekers          @relation(fields: [job_seeker_id], references: [job_seeker_id], onDelete: Cascade)

  @@unique([job_id, job_seeker_id])
  @@index([job_seeker_id], map: "request_apply_job_seeker_id_fkey")
}

enum verified {
  true
  false
}

enum status {
  not_submitted
  submitted
  accepted
  rejected
}

enum role {
  superadmin
  admin
}

enum work_type {
  on_site
  remote
  hybrid
}

enum salary_type {
  monthly_based
  project_based
}

enum job_status {
  active
  draft
}

enum job_category {
  information_and_communication_technology
  finance_and_insurance
  human_resources_and_administration
  sales_and_marketing
  healthcare_and_social_assistance
  education_and_training
  manufacturing
  construction
  arts_entertainment_and_media
  hospitality_and_tourism
  transportation_and_logistics
  public_administration_and_government
  retail
  legal
  science_and_research
}

enum applicant_status {
  pending
  accepted
  rejected
  waiting_interview @map("waiting interview")
  interviewing
}

enum page_category {
  about_us
  privacy_policy
  event
  news
}

enum invitation_status {
  accepted
  rejected
  waiting_interview @map("waiting interview")
}

enum request_apply_status {
  not_applied @map("not applied")
  applied
}
